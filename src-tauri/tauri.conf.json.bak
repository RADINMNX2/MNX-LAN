{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MNX LAN",
  "version": "0.1.0",
  "identifier": "com.radinmnx.mnxlan",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MNX LAN",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      } false,
        "transparent": false,
        "shadow": true,
        "effects": [
          {
            "effect": "mica",
            "roundCorners": true
          }
        ]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Zero-latency Virtual LAN for LAN gaming",
    "longDescription": "MNX LAN by RADIN MNX - an ultra-lightweight virtual LAN gaming suite built on the Wintun kernel driver with direct peer-to-peer tunnels and zero relay servers.",
    "icon": ["icons/icon.ico"],
    "resources": ["assets/**"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}